# TraceLab needs no API keys or secrets. Every variable below is optional.
# TraceLab reads real environment variables; it does NOT load .env files itself.
# Set them in your shell, e.g. `export TRACELAB_OLLAMA_MODEL=llama3` (bash)
# or `$env:TRACELAB_OLLAMA_MODEL = "llama3"` (PowerShell).

# SQLite database for runs, traces and evaluations (relative to the project root).
TRACELAB_DB_PATH=.tracelab/tracelab.db

# Optional local Ollama server and the model name used when a config leaves
# adapter.model empty. TraceLab never downloads models: run `ollama pull <model>` yourself.
TRACELAB_OLLAMA_BASE_URL=http://127.0.0.1:11434
TRACELAB_OLLAMA_MODEL=llama3

# Directories (defaults shown). Paths are relative to TRACELAB_PROJECT_ROOT
# (default: the current working directory).
# TRACELAB_PROJECT_ROOT=.
# TRACELAB_CONFIGS_DIR=configs
# TRACELAB_DATASETS_DIR=datasets

# Test-only switches (read by the test suite, never by the application):
# TRACELAB_OLLAMA_TESTS=1                         run the live Ollama test
# TRACELAB_INJECT_FAULT=presence_only_arg_check   re-introduce the regression-demo bug
